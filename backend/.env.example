# Backend environment variables
# Copy this file to .env and fill in the values

# MongoDB connection (Windows - uses MONGO_URL directly)
MONGO_URL=mongodb://localhost:27017

# MongoDB connection (Linux/Mac - uses individual components)
DB_USER=destiny_mind
DB_PASS=iamironman
DB_HOST=localhost
DB_PORT=27017
AUTH_SOURCE=destiny-neural-memory

# Database name
DB_NAME=payroll_db

# Admin setup key - used to register the first SuperAdmin account
ADMIN_SETUP_KEY=MONTREAL_SETUP_2026
